{
  "private": true,
  "name": "serverless-dns",
  "version": "2.0.0",
  "license": "MPL-2.0",
  "description": "Rethink Free Dns with Blocklist, one click install from github to cloudflare",
  "main": "./src/server-workers.js",
  "type": "module",
  "scripts": {
    "clean": "npm run clean:wrangler",
    "clean:node": "rm -rf node_modules/",
    "clean:wrangler": "rm -rf worker/ dist/",
    "test": "node --test test/unit/*.test.js",
    "build": "sh scripts/prepare.sh --worker && rspack build --config rspack.config.cjs",
    "build:node": "sh scripts/prepare.sh && rspack build --config rspack.node.cjs",
    "build:bun": "sh scripts/prepare.sh && bun build ./src/server-node.js --production --target node --outdir ./dist --entry-naming bun.mjs --format esm",
    "blocklists:prepare": "sh scripts/prepare.sh",
    "lint": "eslint --quiet src test/unit \"test/*.mjs\" scripts",
    "access-key": "node scripts/access-key.mjs",
    "audit:dependencies": "sh scripts/audit-dependencies.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serverless-dns/serverless-dns.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/serverless-dns/serverless-dns/issues"
  },
  "homepage": "https://github.com/serverless-dns/serverless-dns#readme",
  "engines": {
    "node": "^26.13.1"
  },
  "dependencies": {
    "@serverless-dns/dns-parser": "https://codeload.github.com/serverless-dns/dns-parser/tar.gz/b7d73b3d7aca64575887758cb75de599fa3e4c01",
    "@serverless-dns/lfu-cache": "https://codeload.github.com/serverless-dns/lfu-cache/tar.gz/2812043995e23181130e86540df488c588717308",
    "@serverless-dns/trie": "https://codeload.github.com/serverless-dns/trie/tar.gz/6a67356a6856a4173b646112fb90e763fc3156c2"
  },
  "devDependencies": {
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@types/node": "26.6.6",
    "buffer": "6.0.3",
    "eslint": "10.15.0",
    "eslint-config-google": "0.14.0",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "miniflare": "5.20261119.0-beta",
    "prettier": "3.10.1",
    "why-is-node-running": "3.2.3",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "@serverless-dns/lfu-cache": "$@serverless-dns/lfu-cache"
  }
}
