#!/bin/sh
# Local development, not a deployment or traffic generator.
set -eu
case "${1:-node}" in
  n|node) sh scripts/prepare.sh && exec node src/server-node.js ;;
  b|bun) sh scripts/prepare.sh && exec bun src/server-node.js ;;
  d|deno) sh scripts/prepare.sh && exec deno run --no-lock --allow-env --allow-net --allow-read src/server-deno.ts ;;
  w|workers) exec ./node_modules/.bin/wrangler dev --local ;;
  ff|fly) npm run build:fly && exec node dist/fly.mjs ;;
  profile) exec node --cpu-prof test/unit/resolver.test.js ;;
  *) echo "Usage: $0 [node|bun|deno|workers|fly|profile]" >&2; exit 2 ;;
esac
